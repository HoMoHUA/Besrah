{
  "name": "@mashhad-waze/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "osm:bus": "tsx src/bus/cli.ts ../../data/bus/osm/bus_mashhad.json ../../data/bus/lines.json",
    "test:webpush-runtime": "npm run build && node --test tests/webpush-runtime-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "ipaddr.js": "^2.5.0",
    "web-push": "^3.6.7"
  }
}
