<li><a rel="nofollow" class="external text" href="https://sophox.org/#%23defaultView%3AMap%0ASELECT%20%2a%20WHERE%20%7B%0A%20%20%20%20%20%20%20%3Fosm%20osmt%3Arailway%20%22subway_entrance%22%20.%0A%20%20%20%20%20%20%20%3Fosm%20osmm%3Aloc%20%3Floc%20.%0A%7D">Sophox</a></li>
<li><a rel="nofollow" class="external text" href="https://overpass-turbo.eu/?Q=%7B%7Bdata:sql,server=https://postpass.geofabrik.de/api/0.2/%7D%7D%0ASELECT%20osm_id,%20tags,%20geom%0AFROM%20postpass_pointlinepolygon%0AWHERE%20tags-%3E%3E%27railway%27%3D%27subway_entrance%27%0AAND%20geom%20%26%26%20%7B%7Bbbox%7D%7D">Postpass via overpass-turbo</a></li>
